# Cloudflare Pages headers.
# Syntax: a path pattern, then indented header lines.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Fingerprinted-by-content assets. The Instagram images are named by post id,
# so a changed feed means changed filenames — safe to cache hard.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Scoped to *.webp, NOT the whole directory. Cloudflare applies EVERY matching
# rule and concatenates the results rather than letting the most specific win,
# so a bare /assets/instagram/* would also catch feed.json below and emit
# "max-age=31536000, immutable, max-age=0, must-revalidate". Browsers take the
# first directive, so the feed would pin for a year and never update.
/assets/instagram/*.webp
  Cache-Control: public, max-age=31536000, immutable

# feed.json is rewritten in place by the daily job, so it must revalidate.
/assets/instagram/feed.json
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=604800

/assets/js/*
  Cache-Control: public, max-age=604800
